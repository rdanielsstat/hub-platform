# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.

# Cloudflare zone ID for dnls.dev: the domain's Overview page in Cloudflare,
# right sidebar, "Zone ID".
cloudflare_zone_id = "PUT_YOUR_ZONE_ID_HERE"

# Neon connection strings, per environment.
# Neon console > project > Connect (left sidebar, under the branch selector).
#   pooled: Connection pooling toggle ON  (hostname contains -pooler)
#   direct: Connection pooling toggle OFF
neon_urls = {
  dev = {
    pooled = "REPLACE_ME"
    direct = "REPLACE_ME"
  }
  prod = {
    pooled = "REPLACE_ME"
    direct = "REPLACE_ME"
  }
}

# Password for the seeded demo account, per environment. Pick something you
# are happy to publish in the README, and do not reuse a password from
# anywhere else. Omit an environment entirely to give it no demo account.
demo_passwords = {
  dev  = "REPLACE_ME"
  prod = "REPLACE_ME"
}

# Optional overrides (defaults shown):
# aws_region       = "us-east-1"
# lambda_image_tag = "latest"

# OTEL endpoint and auth header for prod Lambda telemetry export to Grafana.
# Get these from Grafana Cloud account settings (Observability > OTLP Ingestion).
otel_endpoint_prod = "https://otlp-gateway-prod-YOUR_REGION.grafana.net/otlp"
otel_headers_prod  = "Authorization=Basic YOUR_ENCODED_CREDENTIALS"
