# Copy to .env and fill in for anything other than local dev.
# Local dev needs none of these — every var below has a safe default.

# "local" (default) or "development"/"dev" — any of these skip the
# production JWT-secret guard (app/core/config.py) and just print a
# warning if HUB_JWT_SECRET is unset. Any other value (e.g.
# "production", "staging") is treated as non-local: the app refuses to
# start unless HUB_JWT_SECRET is set to something other than the dev
# default.
ENVIRONMENT=local

# When true, DATABASE_URL and HUB_JWT_SECRET below are ignored and the
# real settings are fetched at runtime from AWS SSM Parameter Store
# instead (DB_URL_PARAM_NAME / JWT_PARAM_NAME). Used by the Lambda
# deployment; leave unset/false for local dev and Docker Compose, which
# have no AWS access.
USE_SSM=

# Database connection. Defaults to a local SQLite file (hub.db,
# gitignored). Accepts a Postgres URL with no code change, e.g.
# postgresql+psycopg://user:pass@host/db (psycopg is already a
# dependency). A plain postgresql:// URL (as Neon provides it) is
# rewritten to postgresql+psycopg://; the query string (e.g.
# ?sslmode=require&channel_binding=require) is kept as-is. Ignored if
# USE_SSM is true.
DATABASE_URL=sqlite:///./hub.db

# Local only: when true, `python -m app.db.init_local` seeds the demo
# account (hardcoded password, see app/db/seed.py) into an empty
# database. Default false. The app refuses to start, and init_local
# refuses to run, if this is true while USE_SSM is true.
SEED_DEMO_DATA=false

# Comma-separated origins allowed by CORS; whitespace around entries is
# ignored. Defaults to the local Vite dev server. Only matters locally:
# in AWS, CloudFront serves the frontend and API from the same origin.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT signing secret. MUST be set to a strong, unique value in
# production/staging — the app will not start otherwise. Falls back to
# a known, publicly-visible dev-only value locally, which is fine only
# because ENVIRONMENT=local disables the guard. Ignored if USE_SSM is
# true (the secret comes from JWT_PARAM_NAME instead).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(64))"
HUB_JWT_SECRET=

# Minutes a JWT bearer token stays valid after login/register.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Session cookie and login rate limit ---
# Login and register also set the JWT as the hub_token cookie (HttpOnly,
# SameSite=Strict). AUTH_COOKIE_SECURE controls its Secure flag
# (HTTPS-only). Unset means on when deployed (USE_SSM on, or ENVIRONMENT
# not local/development/dev; see is_deployed() in app/core/config.py, so
# the dev Lambda counts) and off for a local run, since the dev servers
# are plain http://localhost. Set true/false to force it either way.
AUTH_COOKIE_SECURE=

# Login attempts allowed per client IP per minute on POST /auth/login;
# over it the API answers 429 with Retry-After. 0 turns the limit off.
# Unset means 5 when deployed (same is_deployed() rule as above) and 0
# (off) for a local run, because the Playwright suite logs in far more
# often than that from 127.0.0.1. Set 5 here to try the deployed
# behavior locally.
LOGIN_RATE_LIMIT_PER_MINUTE=

# Same for sign-ups on POST /auth/register, counted separately. Unset
# means 3 when deployed and 0 (off) for a local run, because the E2E
# suite registers a fresh user for every test.
REGISTER_RATE_LIMIT_PER_MINUTE=

# Same for frontend error reports on POST /client-errors, counted
# separately. Unset means 30 when deployed and 0 (off) for a local run.
CLIENT_ERROR_RATE_LIMIT_PER_MINUTE=

# --- Usage caps (app/core/quotas.py) ---
# Over a cap the API answers 403. 0 turns a cap off; blank means the
# default. Soft limits: concurrent requests at the boundary can overshoot
# by one or two.
#
# Total accounts, checked on POST /auth/register. Unset means 1000 when
# deployed and 0 (off) locally, where the E2E suite registers a fresh
# user per test.
MAX_ACCOUNTS=
# Projects per user (POST /projects). Unset means 500 everywhere.
MAX_PROJECTS_PER_USER=
# Notes per project (POST /projects/{id}/notes). Unset means 500 everywhere.
MAX_NOTES_PER_PROJECT=

# Request header holding the real client IP, used for the login rate
# limit. Unset (the right value locally) means the TCP peer address.
# The Lambdas set CloudFront-Viewer-Address (infra/hub/lambda.tf), since
# behind CloudFront the peer address is CloudFront's, not the user's.
# Only set it when every request passes through the proxy that writes
# the header: a client can send any header it likes.
CLIENT_IP_HEADER=

# Proxies trusted to report the real client in X-Forwarded-For, as
# comma-separated IPs or CIDR ranges (e.g. Cloudflare's published ranges).
# Only when the hop above (CLIENT_IP_HEADER's address, else the peer) is in
# this list does the rate limiter read X-Forwarded-For. Leave unset locally
# and in Docker Compose: no proxy is trusted and the header is ignored. An
# invalid entry stops the app at startup. See security/RATE_LIMITING.md.
TRUSTED_PROXY_IPS=

# Only used when USE_SSM=true: SSM parameter names (SecureString). The
# DB one holds the full connection URL (e.g. /hub-<env>/db-url, Neon's
# pooled URL, normalised the same way as DATABASE_URL above); the JWT
# one holds the raw secret string.
DB_URL_PARAM_NAME=
JWT_PARAM_NAME=

# Only used when USE_SSM=true, and then required: the SSM parameter
# holding the secret CloudFront sends as X-Origin-Verify. Requests
# without it get 403, so the public execute-api URL can't bypass
# CloudFront. Leave unset locally: the check is off without USE_SSM.
ORIGIN_VERIFY_PARAM_NAME=

# --- Observability (OpenTelemetry) ---
# Off unless OTEL_ENABLED is true (1/true/yes); the endpoint and headers
# below are ignored while it's off. The dev Lambda gets all three from
# OpenTofu (infra/hub, dev workspace only).
OTEL_ENABLED=

# Grafana Cloud OTLP endpoint and headers. Leave both unset for local
# dev (with OTEL_ENABLED on, telemetry goes to http://localhost:4318 if a
# collector is running there; otherwise it's logged and skipped).
#
# These are the standard OpenTelemetry variables. Get the values from
# Grafana Cloud's OTLP setup page.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# --- Lambda deployment only ---
# Lambda only (app/lambda_handler.py): path prefix Mangum strips before
# routing. CloudFront forwards /api/* with the prefix intact, so the
# deployment sets this to /api. Unused locally (uvicorn doesn't go
# through Mangum).
API_BASE_PATH=/

# --- Bootstrap only (app/bootstrap_db.py) ---
# `python -m app.bootstrap_db` owns the schema (Alembic migrations, see
# app/db/migrations.py). With USE_SSM=true (cloud) it only migrates,
# using DB_URL_PARAM_NAME above (the
# deployment points it at the direct, non-pooled URL); Neon provides the
# role and database. With USE_SSM unset/false (local) it also creates
# this environment's Postgres database and a least-privilege login role
# (the DATABASE_URL role above), using the master/superuser credentials
# below. Idempotent; the app itself never reads these vars and never
# holds master credentials. See backend/README.md.
#
# Local mode only. Docker Compose sets them for you; only needed by hand
# if you run the bootstrap command outside Compose.
MASTER_DB_HOST=
MASTER_DB_PORT=5432
MASTER_DB_USER=
MASTER_DB_PASSWORD=