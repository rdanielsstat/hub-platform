# Copy to .env and fill in for anything other than local dev.
# Local dev needs none of these — every var below has a safe default.

# "local" (default) or "development"/"dev" — any of these skip the
# production JWT-secret guard (app/core/config.py) and just print a
# warning if HUB_JWT_SECRET is unset. Any other value (e.g.
# "production", "staging") is treated as non-local: the app refuses to
# start unless HUB_JWT_SECRET is set to something other than the dev
# default.
ENVIRONMENT=local

# When true, DATABASE_URL and HUB_JWT_SECRET below are ignored and the
# real settings are fetched at runtime from AWS SSM Parameter Store
# instead (DB_URL_PARAM_NAME / JWT_PARAM_NAME). Used by the Lambda
# deployment; leave unset/false for local dev and Docker Compose, which
# have no AWS access.
USE_SSM=

# Database connection. Defaults to a local SQLite file (hub.db,
# gitignored). Accepts a Postgres URL with no code change, e.g.
# postgresql+psycopg://user:pass@host/db (psycopg is already a
# dependency). A plain postgresql:// URL (as Neon provides it) is
# rewritten to postgresql+psycopg://; the query string (e.g.
# ?sslmode=require&channel_binding=require) is kept as-is. Ignored if
# USE_SSM is true.
DATABASE_URL=sqlite:///./hub.db

# Local only: when true, `python -m app.db.init_local` seeds the demo
# account (hardcoded password, see app/db/seed.py) into an empty
# database. Default false. The app refuses to start, and init_local
# refuses to run, if this is true while USE_SSM is true.
SEED_DEMO_DATA=false

# Comma-separated origins allowed by CORS; whitespace around entries is
# ignored. Defaults to the local Vite dev server. Only matters locally:
# in AWS, CloudFront serves the frontend and API from the same origin.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT signing secret. MUST be set to a strong, unique value in
# production/staging — the app will not start otherwise. Falls back to
# a known, publicly-visible dev-only value locally, which is fine only
# because ENVIRONMENT=local disables the guard. Ignored if USE_SSM is
# true (the secret comes from JWT_PARAM_NAME instead).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(64))"
HUB_JWT_SECRET=

# Minutes a JWT bearer token stays valid after login/register.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Only used when USE_SSM=true: SSM parameter names (SecureString). The
# DB one holds the full connection URL (e.g. /hub-<env>/db-url, Neon's
# pooled URL, normalised the same way as DATABASE_URL above); the JWT
# one holds the raw secret string.
DB_URL_PARAM_NAME=
JWT_PARAM_NAME=

# Lambda only (app/lambda_handler.py): path prefix Mangum strips before
# routing. CloudFront forwards /api/* with the prefix intact, so the
# deployment sets this to /api. Unused locally (uvicorn doesn't go
# through Mangum).
API_BASE_PATH=/

# --- Bootstrap only (app/bootstrap_db.py) ---
# `python -m app.bootstrap_db` owns table creation. With USE_SSM=true
# (cloud) it only creates tables, using DB_URL_PARAM_NAME above (the
# deployment points it at the direct, non-pooled URL); Neon provides the
# role and database. With USE_SSM unset/false (local) it also creates
# this environment's Postgres database and a least-privilege login role
# (the DATABASE_URL role above), using the master/superuser credentials
# below. Idempotent; the app itself never reads these vars and never
# holds master credentials. See backend/README.md.
#
# Local mode only. Docker Compose sets them for you; only needed by hand
# if you run the bootstrap command outside Compose.
MASTER_DB_HOST=
MASTER_DB_PORT=5432
MASTER_DB_USER=
MASTER_DB_PASSWORD=
