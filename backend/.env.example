# Copy to .env and fill in for anything other than local dev.
# Local dev needs none of these — every var below has a safe default.

# "local" (default) or "development"/"dev" — any of these skip the
# production JWT-secret guard (app/core/config.py) and just print a
# warning if HUB_JWT_SECRET is unset. Any other value (e.g.
# "production", "staging") is treated as non-local: the app refuses to
# start unless HUB_JWT_SECRET is set to something other than the dev
# default.
ENVIRONMENT=local

# When true, DATABASE_URL and HUB_JWT_SECRET below are ignored and the
# real settings are fetched at runtime from AWS SSM Parameter Store
# instead (DB_PARAM_NAME / JWT_PARAM_NAME). Used by the Lambda
# deployment; leave unset/false for local dev and Docker Compose, which
# have no AWS access.
USE_SSM=

# Database connection. Defaults to a local SQLite file (hub.db,
# gitignored). Accepts a Postgres URL with no code change, e.g.
# postgresql+psycopg://user:pass@host/db (psycopg is already a
# dependency). Ignored if USE_SSM is true.
DATABASE_URL=sqlite:///./hub.db

# JWT signing secret. MUST be set to a strong, unique value in
# production/staging — the app will not start otherwise. Falls back to
# a known, publicly-visible dev-only value locally, which is fine only
# because ENVIRONMENT=local disables the guard. Ignored if USE_SSM is
# true (the secret comes from JWT_PARAM_NAME instead).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(64))"
HUB_JWT_SECRET=

# Minutes a JWT bearer token stays valid after login/register.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Only used when USE_SSM=true: SSM parameter names (SecureString). The
# DB one holds a JSON string {"username","password","host","port","dbname"};
# the JWT one holds the raw secret string.
DB_PARAM_NAME=
JWT_PARAM_NAME=

# --- Bootstrap only (app/bootstrap_db.py) ---
# `python -m app.bootstrap_db` creates this environment's Postgres
# database and a least-privilege login role for the app to connect as
# (the DATABASE_URL/DB_PARAM_NAME role above). It's a separate,
# run-once, idempotent command; the app itself never reads these vars
# and never holds master credentials. See backend/README.md.
#
# Locally (USE_SSM unset/false): master/superuser credentials come from
# these env vars. Docker Compose sets them for you; only needed by hand
# if you run the bootstrap command outside Compose.
MASTER_DB_HOST=
MASTER_DB_PORT=5432
MASTER_DB_USER=
MASTER_DB_PASSWORD=

# With USE_SSM=true: master credentials instead come from this SSM
# parameter (SecureString, JSON: {"username","password","host","port"}).
MASTER_DB_PARAM_NAME=
