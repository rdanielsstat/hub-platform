{
  "mcpServers": {
    "hub": {
      "command": "uv",
      "args": ["run", "--directory", "mcp-server", "python", "-m", "hub_mcp"],
      "env": {
        "HUB_API_URL": "${HUB_API_URL:-http://localhost:8000}",
        "HUB_EMAIL": "${HUB_EMAIL}",
        "HUB_PASSWORD": "${HUB_PASSWORD}"
      }
    }
  }
}
