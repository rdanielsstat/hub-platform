# Environment variables and local secrets (the .env.example templates are tracked)
.env
.env.*
*.env
!.env.example
.secrets

# Logs
*.log

# Editor / OS
.DS_Store
.vscode/

# OpenTofu / Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
tfplan*
*.tfplan
plan.out

# Python (mcp-server/, agent-hooks/; backend/ has its own .gitignore too)
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/

# Playwright output
playwright-report/
test-results/

# Local scratch files
temp
temp.txt
